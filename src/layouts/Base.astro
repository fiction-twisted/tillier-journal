---
import '@fontsource/bebas-neue/latin.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShare from '../assets/share/tillier-journal.jpg';

interface Props {
  title?: string;
  description?: string;
  /** 'white' for the front page; story pages keep the warm paper tone */
  tone?: 'paper' | 'white';
  /** keep the page out of search engines (drafts and working pages) */
  noindex?: boolean;
  /** the picture shown when the page is shared (LinkedIn, Slack, messages); cropped to 1200 x 630 */
  image?: ImageMetadata;
  imageAlt?: string;
  /** 'article' for story pages */
  type?: 'website' | 'article';
  /** structured data for search engines */
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Tillier Journal',
  description = 'The portfolio of Sigve Tillier, art director and designer in Bergen.',
  tone = 'paper',
  noindex = false,
  image = defaultShare,
  imageAlt = 'Tillier Journal, issue 01: the portfolio of Sigve Tillier',
  type = 'website',
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const shareUrl = new URL(share.src, site).href;
---

<html lang="en" class:list={{ 'tone-white': tone === 'white' }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <!-- link previews -->
    <meta property="og:site_name" content="Tillier Journal" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/npr8loc.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
