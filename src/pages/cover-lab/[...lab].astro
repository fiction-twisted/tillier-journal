---
// Draft page for the Tillier Journal covers. Served in the dev server only: the production build generates no page here.

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { lab: undefined } }] : [];
}
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
---

<Base title="Cover lab — Tillier Journal" noindex>
  <main class="lab">
    <div class="slot"><Cover edition="mirror" /></div>
    <div class="slot"><Cover edition="alyx" /></div>
  </main>
</Base>

<style>
  .lab {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: center;
    align-items: flex-start;
    padding: 48px 24px 96px;
    background: #d9d4cb;
    min-height: 100vh;
  }
  .slot { width: min(560px, 92vw); box-shadow: 0 30px 60px rgb(0 0 0 / 0.25); }
</style>
