---
import Logo from '../assets/tillier-logo.svg';
---

<footer id="subscribe" class="footer">
  <div class="footer-cta">
    <p class="label kicker">Correspondence</p>
    <h2 class="footer-title" data-reveal="lines">Commissions, collaborations &amp; correspondence</h2>
    <a class="footer-email" href="mailto:sigvetillier@gmail.com">sigvetillier@gmail.com</a>
    <ul class="label footer-links">
      <li><a href="https://www.instagram.com/sigvetillier/" target="_blank" rel="noopener">Instagram ↗</a></li>
      <li><a href="https://www.linkedin.com/in/sigve-tillier-20b435386/" target="_blank" rel="noopener">LinkedIn ↗</a></li>
    </ul>
  </div>
  <dl class="colophon label">
    <div><dt>Editor-in-chief</dt><dd>Sigve Tillier</dd></div>
    <div><dt>Art direction</dt><dd>Sigve Tillier</dd></div>
    <div><dt>Typeset in</dt><dd>Bebas Neue (Pro), IvyJournal &amp; Century Gothic</dd></div>
    <div><dt>Printed on</dt><dd>Astro</dd></div>
  </dl>
  <div class="footer-logo" aria-hidden="true"><Logo /></div>
</footer>

<style>
  /* Dark, for contrast at the end of the issue */
  .footer {
    margin-top: var(--footer-gap, 160px);
    padding: 72px var(--gutter) var(--gutter);
    background: var(--ink);
    color: var(--paper);
  }
  .kicker {
    margin-bottom: 18px;
    font-weight: 700;
    color: var(--accent);
  }
  .footer-title {
    max-width: 12em;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 0.9;
    letter-spacing: 0.005em;
  }
  .footer-email {
    display: inline-block;
    margin-top: 36px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(26px, 3.4vw, 48px);
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid rgb(246 243 238 / 0.35);
    transition: color 0.3s, border-color 0.3s;
  }
  .footer-email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .footer-links {
    display: flex;
    gap: 28px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    color: rgb(246 243 238 / 0.7);
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
  .colophon {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 96px 0 48px;
    padding-top: 16px;
    border-top: 1px solid rgb(246 243 238 / 0.25);
  }
  .colophon dt {
    color: rgb(246 243 238 / 0.55);
    margin-bottom: 6px;
  }
  .colophon dd {
    margin: 0;
  }
  .footer-logo {
    color: var(--paper);
  }

  @media (max-width: 800px) {
    .colophon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
